{
  "name": "Velirius-api",
  "version": "1.0.0",
  "description": "Velirius API — REST API sin token: Anime, Canvas, Tools, Downloader, Searcher y Reactions (sin IA, sin NSFW).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
