    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0"
  }
